                                                                "example": "Le champ driver_lat est requis."
                                                            }
                                                        },
                                                        "driver_lng": {
                                                            "type": "array",
                                                            "items": {
                                                                "type": "string",
                                                                "example": "Le champ driver_lng est requis."
                                                            }
                                                        }
                                                    },
                                                    "type": "object"
                                                }
                                            },
                                            "type": "object"
                                        }
