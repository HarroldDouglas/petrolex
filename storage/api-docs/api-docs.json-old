        "/api/tracking/delivery/{orderId}/complete": {
            "patch": {
                "tags": [
                    "Suivi de Livraison"
                ],
                "summary": "Complete delivery tracking",
                "description": "Marks a delivery as completed with optional final position and notes.",
                "operationId": "api.tracking.delivery.complete",
                "parameters": [
                    {
                        "name": "orderId",
                        "in": "path",
                        "description": "The order ID of the delivery to complete",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "description": "Optional completion data",
                    "required": false,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "final_latitude": {
                                        "description": "Final delivery latitude",
                                        "type": "number",
                                        "format": "float",
                                        "maximum": 90,
                                        "minimum": -90,
                                        "example": 3.8512
                                    },
                                    "final_longitude": {
                                        "description": "Final delivery longitude",
                                        "type": "number",
                                        "format": "float",
                                        "maximum": 180,
                                        "minimum": -180,
                                        "example": 11.5098
                                    },
                                    "notes": {
                                        "description": "Delivery completion notes",
                                        "type": "string",
                                        "maxLength": 500,
                                        "example": "Livraison effectuée avec succès. Client satisfait, bouteilles livrées à domicile."
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Delivery completed successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        {
                                            "$ref": "#/components/schemas/ApiResponse"
                                        },
                                        {
                                            "properties": {
                                                "data": {
                                                    "$ref": "#/components/schemas/DeliveryTrackingData"
                                                },
                                                "message": {
                                                    "type": "string",
                                                    "example": "Delivery completed successfully."
                                                }
                                            },
                                            "type": "object"
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Forbidden - Not authorized to complete this delivery",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Delivery tracking not found",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "409": {
                        "description": "Conflict - Delivery already completed",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "422": {
