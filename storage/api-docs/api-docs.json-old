                                "description": "Route duration in minutes",
                                "type": "integer",
                                "example": 25
                            },
                            "geometry": {
                                "description": "GeoJSON route geometry",
                                "type": "object"
                            }
                        },
                        "type": "object"
                    }
                },
                "type": "object"
            },
