        "/api/tracking/delivery/{orderId}/position": {
            "patch": {
                "tags": [
                    "Suivi de Livraison"
                ],
                "summary": "Update delivery tracking position",
                "description": "Updates the geographical position of a delivery.",
                "operationId": "api.tracking.delivery.position.update",
                "parameters": [
                    {
                        "name": "orderId",
                        "in": "path",
                        "description": "The order ID of the delivery to update position",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "description": "Real-time position and tracking data",
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "driver_lat",
                                    "driver_lng"
                                ],
                                "properties": {
                                    "driver_lat": {
                                        "description": "Current latitude of the delivery person",
                                        "type": "number",
                                        "format": "float",
                                        "maximum": 90,
                                        "minimum": -90,
                                        "example": 3.8495
                                    },
                                    "driver_lng": {
                                        "description": "Current longitude of the delivery person",
                                        "type": "number",
                                        "format": "float",
                                        "maximum": 180,
                                        "minimum": -180,
                                        "example": 11.5035
                                    },
                                    "current_speed": {
                                        "description": "Current speed in km/h (optional)",
                                        "type": "number",
                                        "format": "float",
                                        "minimum": 0,
                                        "example": 35.5
                                    },
                                    "progress_percentage": {
                                        "description": "Delivery progress percentage (optional)",
                                        "type": "number",
                                        "format": "float",
                                        "maximum": 100,
                                        "minimum": 0,
                                        "example": 75.2
                                    },
                                    "distance_remaining": {
                                        "description": "Remaining distance in kilometers (optional)",
                                        "type": "number",
                                        "format": "float",
                                        "minimum": 0,
                                        "example": 2.8
                                    },
                                    "estimated_duration": {
                                        "description": "Estimated duration in minutes (optional)",
                                        "type": "integer",
                                        "minimum": 0,
                                        "example": 8
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Successful operation",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        {
                                            "$ref": "#/components/schemas/ApiResponse"
                                        },
                                        {
                                            "properties": {
                                                "data": {
                                                    "$ref": "#/components/schemas/DeliveryTrackingData"
                                                },
                                                "message": {
                                                    "type": "string",
                                                    "example": "Delivery tracking position updated successfully."
                                                }
                                            },
                                            "type": "object"
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Delivery not found",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        {
                                            "$ref": "#/components/schemas/ApiResponse"
                                        },
                                        {
                                            "properties": {
                                                "success": {
                                                    "type": "boolean",
                                                    "example": false
