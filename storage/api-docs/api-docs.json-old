                        "format": "float",
                        "example": 28.5
                    },
                    "total_distance": {
                        "description": "Total distance in kilometers",
                        "type": "number",
                        "format": "float",
                        "example": 12.8
                    },
                    "distance_remaining": {
                        "description": "Remaining distance in kilometers",
                        "type": "number",
                        "format": "float",
                        "example": 4.2
                    },
                    "progress_percentage": {
                        "description": "Delivery progress percentage",
                        "type": "number",
                        "format": "float",
                        "maximum": 100,
                        "minimum": 0,
                        "example": 67.2
                    },
                    "estimated_duration": {
                        "description": "Estimated duration in minutes",
                        "type": "integer",
                        "example": 18
                    },
                    "route_geometry": {
                        "description": "GeoJSON route geometry",
                        "type": "object"
                    },
                    "delivery_notes": {
                        "description": "Delivery completion notes",
                        "type": "string",
                        "nullable": true
                    },
                    "started_at": {
                        "description": "When the delivery was started",
                        "type": "string",
