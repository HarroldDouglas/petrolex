        "/api/delivery-persons/{deliveryPersonId}/orders": {
            "get": {
                "tags": [
                    "Livreurs"
                ],
                "summary": "Get all orders for a specific delivery person",
                "description": "Retrieves a paginated list of orders for a given delivery person, with optional filtering by status, order number, and delivery type.",
                "operationId": "api.delivery-persons.orders",
                "parameters": [
                    {
                        "name": "deliveryPersonId",
                        "in": "path",
                        "description": "ID of the delivery person",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "format": "int64"
                        }
                    },
                    {
                        "name": "status",
                        "in": "query",
                        "description": "Filter orders by status",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "enum": [
                                "confirmed",
                                "in_progress",
                                "delivered",
                                "cancelled",
                                "pending"
                            ]
                        }
                    },
                    {
                        "name": "order_number",
                        "in": "query",
                        "description": "Filter orders by order number (partial match)",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "delivery_type",
                        "in": "query",
                        "description": "Filter orders by delivery type",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "enum": [
                                "normal",
                                "fast"
                            ]
                        }
                    },
                    {
                        "name": "per_page",
                        "in": "query",
                        "description": "Number of orders per page",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "format": "int32",
                            "default": 10,
                            "minimum": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful operation",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        {
                                            "$ref": "#/components/schemas/ApiResponse"
                                        },
                                        {
                                            "properties": {
                                                "data": {
                                                    "type": "array",
                                                    "items": {
                                                        "$ref": "#/components/schemas/DeliveryPersonOrderData"
                                                    }
                                                },
                                                "message": {
                                                    "type": "string",
                                                    "example": "Commandes du livreur récupérées avec succès"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Delivery person not found",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ValidationErrorResponse"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
