{
    "name": "harrold-wafo/laravel-custom-datatable",
    "description": "Custom DataTable extension for Laravel Livewire with PDF, Excel and CSV export capabilities",
    "version": "1.0.0",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Harrold Wafo",
            "email": "harroldwafo@gmail.com"
        }
    ],
    "require": {
        "php": "^8.0",
        "laravel/framework": "^8.0|^9.0|^10.0|^11.0",
        "rappasoft/laravel-livewire-tables": "^3.0",
        "barryvdh/laravel-dompdf": "^2.0|^3.0",
        "maatwebsite/excel": "^3.1"
    },
    "autoload": {
        "psr-4": {
            "HarroldWafo\\LaravelCustomDatatable\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "HarroldWafo\\LaravelCustomDatatable\\DataTableServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}